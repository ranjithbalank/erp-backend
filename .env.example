# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Secrets in production come from the secret manager (Infisical/OpenBao), not this file.

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Never True in production.
DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev defaults to SQLite if unset. TDR-001 mandates PostgreSQL 16 otherwise.
# DATABASE_URL=postgres://erp:erp@localhost:5432/erp
